{
  "name": "repospend",
  "version": "0.1.8",
  "description": "Local-first dashboard for tracking AI coding token usage and API-equivalent spend by repository, session, model, and tool.",
  "license": "Apache-2.0",
  "author": "Mehmet Mustafa Demir",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetdemircs/RepoSpend.git"
  },
  "bugs": {
    "url": "https://github.com/mehmetdemircs/RepoSpend/issues"
  },
  "homepage": "https://github.com/mehmetdemircs/RepoSpend#readme",
  "bin": {
    "repospend": "dist/cli.js"
  },
  "files": [
    "dist",
    "web-dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/llms.txt",
    "docs/data-sources.md",
    "docs/pricing.md",
    "docs/PUBLISHING.md",
    "docs/token-accounting.md",
    "docs/screenshots/*.png",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm --filter @repospend/types --filter @repospend/core build && pnpm --parallel --filter @repospend/server --filter @repospend/web dev",
    "predev": "pnpm doctor:native",
    "build": "pnpm --filter @repospend/web build && node scripts/build-package.mjs",
    "pack:prepare": "pnpm build",
    "prepack": "pnpm pack:prepare",
    "test": "pnpm --filter @repospend/types --filter @repospend/core build && pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @repospend/types --filter @repospend/core build && pnpm --stream --filter @repospend/types --filter @repospend/core --filter @repospend/server --filter @repospend/web typecheck",
    "clean": "pnpm -r clean && rm -rf dist web-dist",
    "rebuild:native": "pnpm rebuild better-sqlite3",
    "doctor:native": "node scripts/check-native.mjs",
    "media:capture": "node scripts/capture-release-media.mjs",
    "media:producthunt": "node scripts/generate-producthunt-media.mjs"
  },
  "keywords": [
    "codex",
    "openai-codex",
    "claude",
    "claude-code",
    "cursor",
    "github-copilot",
    "ai-coding",
    "ai-usage-analytics",
    "developer-tools",
    "token-usage",
    "cost-tracking",
    "ai-cost-tracker",
    "repo-spend",
    "local-first",
    "cli",
    "dashboard",
    "typescript",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "gifenc": "^1.0.3",
    "playwright": "^1.60.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.5",
      "find-my-way": "^9.10.0",
      "fast-uri@3": "^3.1.9",
      "tinypool": "^2.1.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@>=2": "^5.0.12",
      "js-yaml": "^4.3.2",
      "postcss": "^8.5.23",
      "postcss-selector-parser": "^6.1.5",
      "nanoid@3": "^3.3.18",
      "source-map-js": "^1.2.2",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "@babel/core": "^7.29.6"
    }
  }
}
