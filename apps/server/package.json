{
  "name": "@repospend/server",
  "version": "0.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "bin": {
    "repospend": "dist/cli.js"
  },
  "files": [
    "dist",
    "web-dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@repospend/core": "workspace:^",
    "@repospend/types": "workspace:^",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
